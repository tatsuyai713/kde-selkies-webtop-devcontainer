+struct d3d12_cached_texture {
+   struct list_head entry;
+   ID3D12Resource *res;
+   D3D12_RESOURCE_DESC desc;
+   uint32_t format;
+   struct d3d12_resource_state state;
+   bool has_state;
+   enum d3d12_residency_status residency;
+   uint64_t size;
+   int64_t time;
+};
+
+static constexpr uint64_t texture_cache_max_bytes = 256ull * 1024 * 1024;
+
+static bool texcache_dbg(void){ static int v=-1; if(v<0) v=getenv("D3D12_TEXTURE_CACHE_DEBUG")?1:0; return v; }
+#define TEXCACHE_DBG(...) do { if (texcache_dbg()) { fprintf(stderr, "[texcache] " __VA_ARGS__); } } while (0)
+
+/* Field-wise: the struct has padding that callers do not initialise. */
+static bool
+texture_cache_desc_equal(const D3D12_RESOURCE_DESC *a, const D3D12_RESOURCE_DESC *b)
+{
+   return a->Dimension == b->Dimension && a->Alignment == b->Alignment &&
+          a->Width == b->Width && a->Height == b->Height &&
+          a->DepthOrArraySize == b->DepthOrArraySize && a->MipLevels == b->MipLevels &&
+          a->Format == b->Format && a->SampleDesc.Count == b->SampleDesc.Count &&
+          a->SampleDesc.Quality == b->SampleDesc.Quality &&
+          a->Layout == b->Layout && a->Flags == b->Flags;
+}
+
+static void
+texture_cache_release(struct d3d12_cached_texture *tex)
+{
+   if (tex->has_state)
+      d3d12_resource_state_cleanup(&tex->state);
+   tex->res->Release();
+   FREE(tex);
+}
+
+/* Unlinks expired/excess entries; the caller releases them without the lock. */
+static void
+texture_cache_prune_locked(struct d3d12_screen *screen, int64_t now, struct list_head *to_release)
+{
+   list_for_each_entry_safe(struct d3d12_cached_texture, tex, &screen->texture_cache, entry) {
+      if (now - tex->time <= screen->texture_cache_usecs &&
+          screen->texture_cache_bytes <= texture_cache_max_bytes)
+         break;
+      list_del(&tex->entry);
+      screen->texture_cache_bytes -= tex->size;
+      list_addtail(&tex->entry, to_release);
+   }
+}
+
+static void
+texture_cache_release_list(struct list_head *to_release)
+{
+   list_for_each_entry_safe(struct d3d12_cached_texture, tex, to_release, entry) {
+      list_del(&tex->entry);
+      texture_cache_release(tex);
+   }
+}
+
+ID3D12Resource *
+d3d12_texture_cache_take(struct d3d12_screen *screen,
+                         const D3D12_RESOURCE_DESC *desc, uint32_t format,
+                         struct d3d12_resource_state *state, bool *has_state,
+                         enum d3d12_residency_status *residency)
+{
+   if (screen->texture_cache_usecs <= 0)
+      return nullptr;
+
+   ID3D12Resource *res = nullptr;
+   struct list_head to_release;
+   list_inithead(&to_release);
+
+   mtx_lock(&screen->texture_cache_mutex);
+   texture_cache_prune_locked(screen, os_time_get(), &to_release);
+   list_for_each_entry_safe(struct d3d12_cached_texture, tex, &screen->texture_cache, entry) {
+      if (tex->format != format || !texture_cache_desc_equal(&tex->desc, desc))
+         continue;
+      list_del(&tex->entry);
+      screen->texture_cache_bytes -= tex->size;
+      res = tex->res;
+      *state = tex->state;
+      *has_state = tex->has_state;
+      *residency = tex->residency;
+      FREE(tex);
+      break;
+   }
+   unsigned left = list_length(&screen->texture_cache);
+   mtx_unlock(&screen->texture_cache_mutex);
+   TEXCACHE_DBG("take %s %ux%u fmt=%u dxgi=%u flags=%x samples=%u mips=%u layout=%u align=%u cached=%u\n", res ? "HIT " : "MISS",
+                (unsigned)desc->Width, (unsigned)desc->Height, format, (unsigned)desc->Format, (unsigned)desc->Flags,
+                (unsigned)desc->SampleDesc.Count, (unsigned)desc->MipLevels, (unsigned)desc->Layout, (unsigned)desc->Alignment, left);
+
+   texture_cache_release_list(&to_release);
+   return res;
+}
+
+void
+d3d12_texture_cache_flush(struct d3d12_screen *screen)
+{
+   struct list_head to_release;
+   list_inithead(&to_release);
+   mtx_lock(&screen->texture_cache_mutex);
+   list_for_each_entry_safe(struct d3d12_cached_texture, tex, &screen->texture_cache, entry) {
+      list_del(&tex->entry);
+      list_addtail(&tex->entry, &to_release);
+   }
+   screen->texture_cache_bytes = 0;
+   mtx_unlock(&screen->texture_cache_mutex);
+   texture_cache_release_list(&to_release);
+}
+
+/* Takes over bo->res and its tracked state. Returns false if the bo must be
+ * destroyed the normal way. */
+static bool
+texture_cache_put(struct d3d12_bo *bo)
+{
+   struct d3d12_screen *screen = bo->screen;
+   TEXCACHE_DBG("put  cacheable=%d res=%p %ux%u residency=%d size=%u\n", bo->texture_cacheable, (void*)bo->res,
+                (unsigned)bo->texture_cache_desc.Width, (unsigned)bo->texture_cache_desc.Height, (int)bo->residency_status, (unsigned)bo->estimated_size);
+   if (!bo->texture_cacheable || !bo->res || screen->texture_cache_usecs <= 0 ||
+       bo->residency_status == d3d12_permanently_resident ||
+       bo->estimated_size > texture_cache_max_bytes / 4)
+      return false;
+
+   struct d3d12_cached_texture *tex = CALLOC_STRUCT(d3d12_cached_texture);
+   if (!tex)
+      return false;
+   tex->res = bo->res;
+   tex->desc = bo->texture_cache_desc;
+   tex->format = bo->texture_cache_format;
+   tex->has_state = bo->global_state.subresource_states != nullptr;
+   tex->state = bo->global_state;
+   tex->residency = bo->residency_status;
+   tex->size = bo->estimated_size;
+   tex->time = os_time_get();
+
+   struct list_head to_release;
+   list_inithead(&to_release);
+   mtx_lock(&screen->texture_cache_mutex);
+   list_addtail(&tex->entry, &screen->texture_cache);
+   screen->texture_cache_bytes += tex->size;
+   texture_cache_prune_locked(screen, tex->time, &to_release);
+   mtx_unlock(&screen->texture_cache_mutex);
+   texture_cache_release_list(&to_release);
+   return true;
+}
