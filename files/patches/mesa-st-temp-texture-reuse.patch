+/**
+ * Temporary 2D textures for the blit-based glTexSubImage upload and the
+ * glReadPixels staging copy.
+ *
+ * Both paths create a texture, use it once and free it. That is cheap on
+ * native drivers, but on Mesa D3D12 under WSL every texture creation is a
+ * CreateCommittedResource, i.e. a D3DKMTCreateAllocation2 round trip to the
+ * Windows driver; a Wayland compositor uploading damaged wl_shm surfaces and
+ * a screen grabber reading back each frame then stall for tens to hundreds of
+ * milliseconds per frame. Keep a few textures, sized up to coarse steps, and
+ * hand one out again once nobody else references it.
+ *
+ * Reuse relies on the driver ordering a CPU write to the texture after GPU
+ * work recorded earlier (D3D12 uploads through a staging buffer and a copy on
+ * the same queue), so it is enabled for D3D12 screens only;
+ * MESA_ST_TEMP_TEXTURE_CACHE=0 disables it, =1 forces it on.
+ */
+static bool
+st_temp_texture_cache_enabled(struct st_context *st)
+{
+   static int forced = -2;
+   if (forced == -2) {
+      const char *v = os_get_option("MESA_ST_TEMP_TEXTURE_CACHE");
+      forced = v ? (debug_parse_bool_option(v, false) ? 1 : 0) : -1;
+   }
+   if (forced >= 0)
+      return forced;
+   const char *name = st->screen->get_name ? st->screen->get_name(st->screen) : NULL;
+   return name && strncmp(name, "D3D12", 5) == 0;
+}
+
+struct pipe_resource *
+st_get_temp_texture(struct st_context *st, const struct pipe_resource *templ)
+{
+   struct pipe_screen *screen = st->screen;
+
+   if (templ->target != PIPE_TEXTURE_2D || templ->depth0 != 1 ||
+       templ->array_size > 1 || templ->nr_samples > 1 ||
+       !st_temp_texture_cache_enabled(st))
+      return screen->resource_create(screen, templ);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(st->temp_texture_cache); i++) {
+      struct pipe_resource *res = st->temp_texture_cache[i];
+      if (res && res->format == templ->format && res->bind == templ->bind &&
+          res->usage == templ->usage && res->flags == templ->flags &&
+          res->width0 >= templ->width0 && res->height0 >= templ->height0 &&
+          p_atomic_read(&res->reference.count) == 1) {
+         struct pipe_resource *ret = NULL;
+         pipe_resource_reference(&ret, res);
+         return ret;
+      }
+   }
+
+   struct pipe_resource rounded = *templ;
+   rounded.width0 = MIN2(align(templ->width0, 256), screen->caps.max_texture_2d_size);
+   rounded.height0 = MIN2(align(templ->height0, 64), screen->caps.max_texture_2d_size);
+   struct pipe_resource *res = screen->resource_create(screen, &rounded);
+   if (!res)
+      return screen->resource_create(screen, templ);
+
+   unsigned slot = st->temp_texture_cache_next++ % ARRAY_SIZE(st->temp_texture_cache);
+   pipe_resource_reference(&st->temp_texture_cache[slot], res);
+   return res;
+}
+
+void
+st_release_temp_texture_cache(struct st_context *st)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(st->temp_texture_cache); i++)
+      pipe_resource_reference(&st->temp_texture_cache[i], NULL);
+}
