+/// Runs FFmpeg in a separate address space on WSL.  Mesa's D3D12 OpenGL and
+/// VA-API drivers both load the Windows Intel UMD; keeping them in one process
+/// makes Intel's video path reject surface creation or crash in vaEndPicture.
+/// The child receives NV12 readback frames and performs upload + H.264 encode
+/// on the Intel GPU, while the parent continues to render with D3D12 OpenGL.
+struct ExternalVaapiProcess {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: ChildStdout,
+}
+
+impl Drop for ExternalVaapiProcess {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+impl ExternalVaapiProcess {
+    fn spawn(settings: &RustCaptureSettings) -> Result<Self, String> {
+        let width = settings.width.max(2);
+        let height = settings.height.max(2);
+        let fps = settings.target_fps.max(1.0).round() as i32;
+        let device = if settings.encode_node_path.is_empty() {
+            if settings.encode_node_index >= 0 {
+                format!("/dev/dri/renderD{}", 128 + settings.encode_node_index)
+            } else {
+                "/dev/dri/card0".to_string()
+            }
+        } else {
+            settings.encode_node_path.clone()
+        };
+        let configured_max_kbps = std::env::var("PIXELFLUX_VAAPI_MAX_BITRATE_KBPS")
+            .ok().and_then(|v| v.parse::<i32>().ok())
+            .unwrap_or(8000).clamp(1, 8000);
+        let configured_target_kbps = std::env::var("PIXELFLUX_VAAPI_TARGET_BITRATE_KBPS")
+            .ok().and_then(|v| v.parse::<i32>().ok())
+            .unwrap_or(4000).clamp(1, configured_max_kbps);
+        // Browser local storage can retain the former 12 Mbps value and send
+        // it after the server starts. Honour lower user choices, never values
+        // above the operator's VBR target.
+        let target_kbps = settings.video_bitrate_kbps.clamp(1, configured_target_kbps);
+        let max_kbps = configured_max_kbps.max(target_kbps);
+        let rc_mode = std::env::var("PIXELFLUX_VAAPI_RATE_CONTROL")
+            .unwrap_or_else(|_| "CBR".into()).to_ascii_uppercase();
+        let gop = (fps * settings.keyframe_interval_s.max(1.0).round() as i32)
+            .clamp(fps, 300);
+
+        let mut cmd = Command::new("/usr/bin/ffmpeg");
+        cmd.args([
+            "-hide_banner", "-loglevel", "warning",
+            "-vaapi_device", &device,
+            "-f", "rawvideo", "-pix_fmt", "nv12",
+            "-s", &format!("{}x{}", width, height),
+            "-r", &fps.to_string(), "-i", "pipe:0",
+            "-vf", "hwupload", "-c:v", "h264_vaapi",
+            "-profile:v", "high", "-level:v", "4.1",
+            "-bf", "0", "-g", &gop.to_string(),
+            "-async_depth", "1", "-rc_mode", if rc_mode == "VBR" { "VBR" } else { "CBR" },
+            "-b:v", &format!("{}k", target_kbps),
+            "-maxrate", &format!("{}k", max_kbps),
+            "-bufsize", &format!("{}k", max_kbps),
+            "-f", "h264", "-flush_packets", "1", "pipe:1",
+        ]);
+        let mut child = cmd.stdin(Stdio::piped()).stdout(Stdio::piped()).spawn()
+            .map_err(|e| format!("failed to start external VAAPI FFmpeg: {e}"))?;
+        let stdin = child.stdin.take().ok_or("external VAAPI stdin unavailable")?;
+        let stdout = child.stdout.take().ok_or("external VAAPI stdout unavailable")?;
+        unsafe {
+            let fd = stdout.as_raw_fd();
+            let flags = libc::fcntl(fd, libc::F_GETFL);
+            if flags >= 0 { libc::fcntl(fd, libc::F_SETFL, flags | libc::O_NONBLOCK); }
+        }
+        Ok(Self { child, stdin, stdout })
+    }
+
+    fn encode(&mut self, frame: &[u8]) -> Result<Vec<u8>, String> {
+        self.stdin.write_all(frame).map_err(|e| format!("external VAAPI input failed: {e}"))?;
+        self.stdin.flush().map_err(|e| format!("external VAAPI flush failed: {e}"))?;
+
+        let fd = self.stdout.as_raw_fd();
+        let mut output = Vec::new();
+        let mut first_wait = true;
+        loop {
+            let mut pfd = libc::pollfd { fd, events: libc::POLLIN, revents: 0 };
+            let timeout = if first_wait { 1500 } else { 5 };
+            let ready = unsafe { libc::poll(&mut pfd, 1, timeout) };
+            if ready < 0 { return Err("external VAAPI output poll failed".into()); }
+            if ready == 0 {
+                if output.is_empty() { return Err("external VAAPI output timed out".into()); }
+                break;
+            }
+            first_wait = false;
+            let mut chunk = [0u8; 65536];
+            loop {
+                match self.stdout.read(&mut chunk) {
+                    Ok(0) => return Err("external VAAPI FFmpeg exited".into()),
+                    Ok(n) => output.extend_from_slice(&chunk[..n]),
+                    Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => break,
+                    Err(e) => return Err(format!("external VAAPI output failed: {e}")),
+                }
+            }
+        }
+        Ok(output)
+    }
+}
+
+fn annexb_has_idr(data: &[u8]) -> bool {
+    (0..data.len().saturating_sub(4)).any(|i| {
+        let start3 = data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1;
+        let start4 = data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 0 && data[i + 3] == 1;
+        let nal = if start3 { i + 3 } else if start4 { i + 4 } else { return false; };
+        nal < data.len() && (data[nal] & 0x1f) == 5
+    })
+}
