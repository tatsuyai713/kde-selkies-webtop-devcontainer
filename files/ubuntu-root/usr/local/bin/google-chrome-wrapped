#!/bin/bash
set -e

# Running with the desktop user's HOME as root makes Chrome replace profile
# settings with root-owned mode-0600 files, breaking the next desktop launch.
if (( EUID == 0 )); then
  echo "Do not start Chrome as root. Run this wrapper as the desktop user (docker exec --user <desktop-user> ...)." >&2
  exit 1
fi

# Chrome spawns many helper processes and its Linux proxy-config service opens
# inotify/fd handles. The container's low open-file soft limit (1024) starves
# the network service, so every page hangs at "loading". Raise the soft limit
# to the inherited hard ceiling for this browser process tree.
_hard_nofile="$(ulimit -Hn 2>/dev/null || true)"
if [ "${_hard_nofile}" = "unlimited" ]; then
  ulimit -Sn 1048576 2>/dev/null || true
elif [ -n "${_hard_nofile}" ]; then
  ulimit -Sn "${_hard_nofile}" 2>/dev/null || true
fi

CHROME_BIN=/usr/bin/google-chrome-stable
export XMODIFIERS="@im=fcitx"
export INPUT_METHOD=fcitx

GPU_FLAGS=()
WSL_PROFILE="${ENCODER:-${GPU_VENDOR:-}}"
case "${WSL_PROFILE}" in
  intel-wsl|nvidia-wsl|amd-wsl) WSL_D3D12_PROFILE=true ;;
  *) WSL_D3D12_PROFILE=false ;;
esac
if [ "${WSL_ENVIRONMENT:-false}" = "true" ] && [ "${WSL_D3D12_PROFILE}" = "true" ]; then
  # Native Wayland's virtual GBM/dmabuf synchronization is extremely slow in
  # this nested WSL compositor. XWayland logs a harmless vgem DRI3 failure,
  # then ANGLE initializes Mesa D3D12 directly (verified OpenGL 4.1 on Intel).
  unset LD_PRELOAD WSL_D3D12_COMPOSITOR_ONLY
  unset LIBGL_ALWAYS_SOFTWARE MESA_LOADER_DRIVER_OVERRIDE
  # The Qt6 shim selected below has the installed Wayland platform plugin.
  export QT_QPA_PLATFORM=xcb
  export GALLIUM_DRIVER=d3d12
  case "${WSL_PROFILE}" in
    intel-wsl)  WSL_ADAPTER=Intel ;;
    nvidia-wsl) WSL_ADAPTER=NVIDIA ;;
    amd-wsl)    WSL_ADAPTER=Radeon ;;
  esac
  export MESA_D3D12_DEFAULT_ADAPTER_NAME="${MESA_D3D12_DEFAULT_ADAPTER_NAME:-${WSL_ADAPTER}}"

  # Use D3D12 VA-API for browser video acceleration. Intel needs its isolated
  # compatibility driver; NVIDIA and AMD keep the system Mesa driver.
  export LIBVA_DRIVER_NAME=d3d12
  if [ "${WSL_PROFILE}" = "intel-wsl" ]; then
    export LIBVA_DRIVERS_PATH=/opt/wsl-vaapi-legacy
    export LD_LIBRARY_PATH="/opt/wsl-vaapi-legacy:/usr/lib/wsl/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
  else
    unset LIBVA_DRIVERS_PATH
    export LD_LIBRARY_PATH="/usr/lib/wsl/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
  fi

  # Ubuntu's unrelated native Vulkan ICDs probe devices that do not exist in
  # WSL and have crashed Chrome before ANGLE reaches its OpenGL backend. Keep
  # Vulkan off for Chrome; OpenGL, raster, decode and encode remain on Intel.
  export NODEVICE_SELECT=1
  export VK_DRIVER_FILES=/dev/null
  export VK_ICD_FILENAMES=/dev/null
  # Mesa's Kopper presentation path crashes GLX/EGL-on-X11 clients on WSL once the
  # vgem render node exists ("failed to load driver: d3d12", then SIGSEGV in
  # glXCreateContext). Chromium's ANGLE then gives up and runs with
  # --use-gl=disabled (CPU rendering: choppy Chrome / VS Code). Without Kopper,
  # Mesa uses its plain swrast presentation and GLX renders on D3D12 again.
  export LIBGL_KOPPER_DISABLE=true
  # XWayland runs without glamor on WSL (XWAYLAND_NO_GLAMOR, see startwm_wayland.sh).
  # Mesa's GLX then hands ANGLE a GL 3.2 context by default and ANGLE refuses it
  # ("GLES3 is unsupported") -> --use-gl=disabled. D3D12 really offers GL 4.6
  # core; advertising it lets ANGLE run on the GPU (measured 59.6 vs 31 FPS on a
  # full-window animation; ANGLE's EGL backend only reached 31.8).
  export MESA_GL_VERSION_OVERRIDE="${MESA_GL_VERSION_OVERRIDE:-4.6}"
  # Drop GPU caches written under a different (possibly broken) GL setup.
  if [ -r /usr/local/lib/wsl-gpu-cache-guard.sh ]; then
    . /usr/local/lib/wsl-gpu-cache-guard.sh
    wsl_gpu_cache_guard "$(wsl_user_data_dir "${HOME}/.config/google-chrome" "$@")" "/opt/google/chrome/"
  fi
  GPU_FLAGS=(
    --ozone-platform=x11
    --qt-version=6
    --enable-gpu-rasterization
    --disable-lcd-text
    --disable-webgpu
    --use-gl=angle
    --use-angle=gl
    --use-vulkan=disabled
    --enable-features=AcceleratedVideoEncoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,VaapiIgnoreDriverChecks
    --disable-features=WebGPU,WebGPUService,WebGPUBlobCache,Vulkan,VulkanFromANGLE,DefaultANGLEVulkan,SkiaGraphite
  )
elif [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]; then
  GPU_FLAGS=(--ozone-platform=wayland)
else
  GPU_FLAGS=(--ozone-platform=x11)
fi

EXTRA_FLAGS=(${CHROME_EXTRA_FLAGS:-})
# Chrome's own sandbox instead of --no-sandbox. Its layer 1 is either
# unprivileged user namespaces or the setuid helper shipped next to the binary
# (owned by root, mode 4755; usable while this process may still gain
# privileges, i.e. no no_new_privs). Ubuntu 24.04+ hosts set
# kernel.apparmor_restrict_unprivileged_userns=1, which denies user namespaces
# to this AppArmor-unconfined container, and Chrome then uses the helper; both
# paths were verified in the running container. Only when neither can work is
# --no-sandbox added, so the browser still starts, and the fallback is reported.
chrome_sandbox_usable() {
  local helper
  if ! grep -qs '^NoNewPrivs:[[:space:]]*1' /proc/self/status; then
    for helper in "${CHROME_DEVEL_SANDBOX:-}" "$@"; do
      [ -n "${helper}" ] && [ -u "${helper}" ] && [ -x "${helper}" ] \
        && [ "$(stat -c %u "${helper}" 2>/dev/null)" = "0" ] && return 0
    done
  fi
  unshare -Urn true 2>/dev/null
}
SANDBOX_FLAGS=()
if ! chrome_sandbox_usable "$(dirname "$(readlink -f "${CHROME_BIN}")")/chrome-sandbox" /opt/google/chrome/chrome-sandbox; then
  echo "google-chrome-wrapped: no usable Chrome sandbox (setuid helper or user namespaces); starting with --no-sandbox" >&2
  SANDBOX_FLAGS=(--no-sandbox)
fi
exec "${CHROME_BIN}" --password-store=basic "${GPU_FLAGS[@]}" "${SANDBOX_FLAGS[@]}" "${EXTRA_FLAGS[@]}" "$@"
