#!/usr/bin/with-contenv bash

TARGET_USER="${CUSTOM_USER:-${USER_NAME:-root}}"

# ensure runtime dir for DBus/Qt
TARGET_UID=$(id -u "${TARGET_USER}" 2>/dev/null || true)
if [ -n "${TARGET_UID}" ]; then
  RUNTIME_DIR="/run/user/${TARGET_UID}"
  if ! mkdir -p "${RUNTIME_DIR}"; then
    RUNTIME_DIR="/tmp/runtime-${TARGET_UID}"
    mkdir -p "${RUNTIME_DIR}"
  fi
  chown "${TARGET_USER}:${TARGET_USER}" "${RUNTIME_DIR}" || true
  chmod 700 "${RUNTIME_DIR}" || true
fi

# wayland entrypoint
if [[ "${PIXELFLUX_WAYLAND}" == "true" ]]; then
  # selkies owns the compositor socket; the desktop is only a client of it.
  # Never wait forever on the configured name: docker compose interpolates
  # ${WAYLAND_DISPLAY} in the compose file from the invoking shell before it
  # falls back to the env file, so a host session (WSLg exports wayland-0) can
  # hand us a name selkies never creates. That left the desktop unstarted and
  # the browser showing nothing but a black stream. Give the configured socket
  # a grace period, then take whichever one selkies actually made.
  WL_NAME="${WAYLAND_DISPLAY:-wayland-1}"
  SOCKET_PATH="${XDG_RUNTIME_DIR}/${WL_NAME}"
  echo "[svc-de] Wayland mode: Waiting for socket at ${SOCKET_PATH}..."
  for _ in $(seq 1 60); do
    [ -S "${SOCKET_PATH}" ] && break
    sleep 0.5
  done
  if [ ! -S "${SOCKET_PATH}" ]; then
    FOUND=""
    while [ -z "${FOUND}" ]; do
      FOUND="$(find "${XDG_RUNTIME_DIR}" -maxdepth 1 -type s -name 'wayland-*' 2>/dev/null | head -1)"
      [ -z "${FOUND}" ] && sleep 0.5
    done
    WL_NAME="$(basename "${FOUND}")"
    SOCKET_PATH="${FOUND}"
    echo "[svc-de] WARNING: ${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY} never appeared; using ${WL_NAME} instead."
    export WAYLAND_DISPLAY="${WL_NAME}"
  fi
  echo "[svc-de] ${SOCKET_PATH} found launching de"
  cd $HOME
  exec s6-setuidgid "${TARGET_USER}" \
    /bin/bash /defaults/startwm_wayland.sh &
  PID=$!
  echo "$PID" > /de-pid
  wait "$PID"

  # KWin is a client of the selkies/pixelflux compositor. When pixelflux loses
  # its GPU device (Mesa d3d12 logs "D3D12: Removing Device." after a Windows
  # driver reset/TDR or a host suspend on WSL2), it never recreates it: every
  # dmabuf KWin hands over is rejected with a protocol error
  # ("create_immed failed and produced an invalid wl_buffer"), KWin dies, and
  # the plain restart loop below would just repeat that forever with a black
  # browser. Detect that signature in the session log and restart selkies so
  # the next desktop start talks to a compositor with a fresh GPU device.
  KWIN_LOG="/dev/shm/startplasma-wayland-${TARGET_UID}.log"
  if [ -r "${KWIN_LOG}" ] && grep -qE "create_immed failed and produced an invalid wl_buffer|Wayland connection broke" "${KWIN_LOG}"; then
    echo "[svc-de] KWin lost its connection to the pixelflux compositor (dmabuf import rejected, GPU device lost?); restarting svc-selkies before the next desktop start" >&2
    s6-svc -r /run/service/svc-selkies
    # Give the old compositor a moment to drop its socket so the next round
    # does not connect to a half-dead instance.
    for _ in $(seq 1 20); do
      [ -S "${SOCKET_PATH}" ] || break
      sleep 0.5
    done
  fi
  exit 1
fi

# wait for X to be running
while true; do
  if xset q &>/dev/null; then
    break
  fi
  sleep .5
done

# set resolution before starting apps
RESOLUTION_WIDTH=${SELKIES_MANUAL_WIDTH:-1024}
RESOLUTION_HEIGHT=${SELKIES_MANUAL_HEIGHT:-768}
if [ "$RESOLUTION_WIDTH" = "0" ]; then RESOLUTION_WIDTH=1024; fi
if [ "$RESOLUTION_HEIGHT" = "0" ]; then RESOLUTION_HEIGHT=768; fi
MODELINE=$(s6-setuidgid "${TARGET_USER}" cvt "${RESOLUTION_WIDTH}" "${RESOLUTION_HEIGHT}" | grep "Modeline" | sed 's/^.*Modeline //')
MODELINE_ARGS=$(echo "$MODELINE" | tr -d '"')
MODELINE_NAME=$(echo "$MODELINE_ARGS" | awk '{print $1}')
if ! s6-setuidgid "${TARGET_USER}" xrandr | grep -q "$MODELINE_NAME"; then
  s6-setuidgid "${TARGET_USER}" xrandr --newmode $MODELINE_ARGS
  s6-setuidgid "${TARGET_USER}" xrandr --addmode screen "$MODELINE_NAME"
fi
s6-setuidgid "${TARGET_USER}" xrandr --output screen --mode "$MODELINE_NAME" --dpi "${DPI:-96}"

# Keep persisted Xresources in sync with the container DPI.
DPI_VALUE="${DPI:-96}"
if [ -f "${HOME}/.Xresources" ]; then
  if grep -q '^Xft\.dpi:' "${HOME}/.Xresources"; then
    sed -i "s/^Xft\.dpi:.*/Xft.dpi: ${DPI_VALUE}/" "${HOME}/.Xresources"
  else
    printf '\nXft.dpi: %s\n' "${DPI_VALUE}" >> "${HOME}/.Xresources"
  fi
else
  printf 'Xcursor.theme: breeze\nXft.dpi: %s\n' "${DPI_VALUE}" > "${HOME}/.Xresources"
fi
xrdb "${HOME}/.Xresources"
if [[ "${LANG:-}" == ja* ]]; then
  setxkbmap -layout jp -model jp106 -option ''
fi
chown "${TARGET_USER}:${TARGET_USER}" "${HOME}/.Xresources"
chmod 777 /tmp/selkies*

# Harden home ownership for persisted volumes (avoids root-owned files causing black screens)
chown -R "${TARGET_USER}:${TARGET_USER}" "${HOME}/.config" "${HOME}/.local" "${HOME}/.cache" 2>/dev/null || true
for f in "${HOME}/.xsettingsd" "${HOME}/.Xauthority" "${HOME}/.ICEauthority"; do
  [ -e "$f" ] && chown "${TARGET_USER}:${TARGET_USER}" "$f" 2>/dev/null || true
done
# Ensure UDisks2 activation is gone at runtime too
rm -f /usr/share/dbus-1/system-services/org.freedesktop.UDisks2.service

# run
cd $HOME
exec s6-setuidgid "${TARGET_USER}" \
  /bin/bash /defaults/startwm.sh &
PID=$!
echo "$PID" > /de-pid
wait "$PID"
