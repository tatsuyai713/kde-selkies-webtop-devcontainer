#!/usr/bin/with-contenv bash

TARGET_USER="${CUSTOM_USER:-${USER_NAME:-root}}"
PORT="${SELKIES_PORT:-8082}"
TARGET_UID_SEL="$(id -u "${TARGET_USER}" 2>/dev/null || echo 1000)"
. /usr/local/lib/pulse-runtime.sh
webtop_configure_pulse_runtime "${TARGET_UID_SEL}"

# selkies (Wayland mode) builds its keysym->scancode table from XKB_DEFAULT_*
# (see patch-selkies-wayland-keymap.py). It must match the layout KWin uses
# (startwm_wayland.sh exports XKB_DEFAULT_LAYOUT=jp, kxkbrc says jp/jp106);
# otherwise shifted keys are re-interpreted (Shift+2 -> '*', Shift+8 -> ')').
if [[ "${LANG:-}" == ja* ]]; then
  export XKB_DEFAULT_LAYOUT="${XKB_DEFAULT_LAYOUT:-jp}"
  export XKB_DEFAULT_MODEL="${XKB_DEFAULT_MODEL:-jp106}"
fi

# ENCODER is passed from start-container.sh: software|nvidia|nvidia-wsl|intel|amd|intel-wsl|amd-wsl
ENCODER="${ENCODER:-}"
GPU_VENDOR="${ENCODER:-${GPU_VENDOR:-software}}"

# The official pixelflux 2 wheel bundles a compatible FFmpeg.  Select its
# one-slice binary only for Intel WSL; all other profiles retain the exact
# vendor module prepared during the image build.
if [ -x /usr/local/bin/patch-pixelflux-intel-wsl-slices.py ]; then
  PIXELFLUX_VARIANT=default
  if [ "${GPU_VENDOR}" = "intel-wsl" ]; then
    PIXELFLUX_VARIANT=intel-wsl
  fi
  /opt/selkies-env/bin/python3 \
    /usr/local/bin/patch-pixelflux-intel-wsl-slices.py \
    --select "${PIXELFLUX_VARIANT}"
fi

# Check if running in WSL environment
WSL_ENVIRONMENT="${WSL_ENVIRONMENT:-false}"

# Export LIBVA_DRIVER_NAME for Intel/AMD VA-API (set by start-container.sh)
if [ -n "${LIBVA_DRIVER_NAME}" ]; then
  export LIBVA_DRIVER_NAME
  echo "[svc-selkies] Using VA-API driver: ${LIBVA_DRIVER_NAME}"
fi

# WSL2 specific setup for NVIDIA - add WSL libs to paths
if [ "${WSL_ENVIRONMENT}" = "true" ]; then
  echo "[svc-selkies] Running in WSL2 environment"
  if [ -d "/usr/lib/wsl/lib" ]; then
    # Remove /usr/lib/wsl/lib if already present, then add to front
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH//\/usr\/lib\/wsl\/lib:/}"
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH//\/usr\/lib\/wsl\/lib/}"
    export LD_LIBRARY_PATH="/usr/lib/wsl/lib:${LD_LIBRARY_PATH}"
    export PATH="/usr/lib/wsl/lib:${PATH}"
    echo "[svc-selkies] Added WSL library path at front: /usr/lib/wsl/lib"
  fi
fi

# Function to find nvidia-smi (handles WSL2 where it's in /usr/lib/wsl/lib)
find_nvidia_smi() {
  if command -v nvidia-smi &> /dev/null; then
    echo "nvidia-smi"
  elif [ -x "/usr/lib/wsl/lib/nvidia-smi" ]; then
    echo "/usr/lib/wsl/lib/nvidia-smi"
  else
    return 1
  fi
}

# Check if NVIDIA GPU is available (works on both native Linux and WSL2)
nvidia_available() {
  local nvidia_smi_cmd
  nvidia_smi_cmd=$(find_nvidia_smi) || return 1
  "${nvidia_smi_cmd}" >/dev/null 2>&1
}

# Configure pixelflux hardware encoding based on GPU_VENDOR
# pixelflux supports: NVENC (NVIDIA), VA-API (Intel/AMD)
# Setting vaapi_render_node_index >= 0 enables VA-API encoding on /dev/dri/renderD(128 + index)
# -1 means try NVENC if available, otherwise software

# Determine GPU render node index for pixelflux
# PIXELFLUX_VAAPI_RENDER_NODE_INDEX:
#   -1 = Use NVENC (NVIDIA) or software fallback
#   0+ = Use VA-API with /dev/dri/renderD(128+index)
# pixelflux opens NVENC through libcuda.so.1 and libnvidia-encode.so.1. Confirm
# both work before promising hardware encoding (native: NVIDIA Container
# Toolkit; WSL2: /usr/lib/wsl/lib, already at the front of LD_LIBRARY_PATH).
nvenc_runtime_available() {
  /opt/selkies-env/bin/python3 - <<'PY'
import ctypes
import sys

try:
    cuda = ctypes.CDLL("libcuda.so.1")
    nvenc = ctypes.CDLL("libnvidia-encode.so.1")
except OSError as exc:
    print(f"[svc-selkies] NVENC runtime unavailable: {exc}", file=sys.stderr)
    sys.exit(1)
count = ctypes.c_int(0)
if cuda.cuInit(0) != 0 or cuda.cuDeviceGetCount(ctypes.byref(count)) != 0 or count.value < 1:
    print("[svc-selkies] NVENC runtime unavailable: CUDA reports no usable device", file=sys.stderr)
    sys.exit(1)
version = ctypes.c_uint(0)
if nvenc.NvEncodeAPIGetMaxSupportedVersion(ctypes.byref(version)) != 0:
    print("[svc-selkies] NVENC runtime unavailable: NvEncodeAPI version query failed", file=sys.stderr)
    sys.exit(1)
print(f"[svc-selkies] NVENC runtime ready: {count.value} CUDA device(s), "
      f"NvEncodeAPI {version.value >> 4}.{version.value & 0xF}")
PY
}

# Real H.264 encode through Mesa's d3d12 VA-API driver on the WSL node, run
# with the environment the encoder child later inherits from this process.
# Some Windows drivers advertise EncSlice but return empty bitstreams, so the
# coded packets are counted instead of trusting vainfo. Used by amd-wsl; the
# intel-wsl profile pins its own validated Mesa build instead.
wsl_d3d12_vaapi_preflight() {
  local node="$1" out log frames size status=1
  if [ ! -x /usr/bin/ffmpeg ] || [ ! -x /usr/bin/ffprobe ]; then
    echo "[svc-selkies] /usr/bin/ffmpeg or ffprobe missing; cannot verify D3D12 VA-API encode" >&2
    return 1
  fi
  out=$(mktemp --suffix=.h264) || return 1
  log=$(mktemp) || { rm -f "${out}"; return 1; }
  if timeout --signal=TERM --kill-after=3 25 \
       /usr/bin/ffmpeg -nostdin -y -hide_banner -loglevel error \
       -vaapi_device "${node}" \
       -f lavfi -i testsrc2=size=640x360:rate=30 -frames:v 30 \
       -vf format=nv12,hwupload -c:v h264_vaapi -profile:v high -level:v 4.1 \
       -bf 0 -async_depth 1 -rc_mode VBR -b:v 4M -maxrate 8M -bufsize 8M \
       -f h264 "${out}" 2>"${log}"; then
    size=$(stat -c %s "${out}" 2>/dev/null || echo 0)
    frames=$(/usr/bin/ffprobe -v error -select_streams v:0 -count_packets \
               -show_entries stream=nb_read_packets -of csv=p=0 "${out}" 2>/dev/null || echo 0)
    if [ "${size:-0}" -gt 1024 ] && [ "${frames:-0}" -ge 30 ]; then
      status=0
      echo "[svc-selkies] D3D12 VA-API preflight on ${node}: ${frames} H.264 packets, ${size} bytes"
    else
      echo "[svc-selkies] D3D12 VA-API preflight on ${node} produced no usable H.264 (packets=${frames:-0}, bytes=${size:-0})" >&2
    fi
  else
    echo "[svc-selkies] D3D12 VA-API preflight on ${node} failed" >&2
  fi
  [ "${status}" -eq 0 ] || sed 's/^/[svc-selkies] ffmpeg: /' "${log}" >&2
  rm -f "${out}" "${log}"
  return "${status}"
}

# SELKIES_FORCE_HARDWARE_ENCODING=1 (patch-selkies-pixelflux2.py) makes the
# server-side GPU profile authoritative: a browser whose localStorage still
# carries use_cpu=true or x264enc-striped from an earlier software session
# would otherwise keep every reconnect on CPU x264 while the logs claim a GPU
# encoder. Set below by every profile that verified its hardware path.
NVIDIA_DRI_NODE_OPT=""

if [ "${GPU_VENDOR}" = "nvidia" ] || [ "${GPU_VENDOR}" = "nvidia-wsl" ]; then
  # NVIDIA: Explicitly disable VA-API to force NVENC
  export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
  # Find the NVIDIA DRM render node (native Linux only; WSL2 has none).
  NVIDIA_RENDER_NODE=""
  for renderD in /dev/dri/renderD*; do
    if [ -e "$renderD" ]; then
      RENDER_NUM=$(echo "$renderD" | grep -oP 'renderD\K[0-9]+')
      DRIVER_LINK="/sys/class/drm/renderD${RENDER_NUM}/device/driver"
      if [ -L "$DRIVER_LINK" ]; then
        DRIVER_NAME=$(basename "$(readlink -f "$DRIVER_LINK")")
        if [ "$DRIVER_NAME" = "nvidia" ]; then
          NVIDIA_RENDER_NODE="$renderD"
          echo "[svc-selkies] Found NVIDIA GPU at renderD${RENDER_NUM}"
          break
        fi
      fi
    fi
  done

  if nvidia_available; then
    NVIDIA_SMI_CMD=$(find_nvidia_smi)
    echo "[svc-selkies] NVIDIA GPU detected via: ${NVIDIA_SMI_CMD}"
  fi
  NVENC_READY=false
  if nvenc_runtime_available; then
    NVENC_READY=true
  else
    echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: NVENC runtime check failed; pixelflux will encode with CPU x264. Start the container with --gpus (NVIDIA Container Toolkit) or update the Windows NVIDIA driver / WSL." >&2
  fi

  if [ "${GPU_VENDOR}" = "nvidia" ]; then
    # Native Linux: pixelflux recognises NVENC from the render node's kernel
    # driver. Hand it that node explicitly for both the compositor and the
    # encoder; with pixelflux's default "first GPU" choice a hybrid machine
    # whose renderD128 is the iGPU renders there and encodes through its
    # VA-API driver instead of NVENC.
    if [ -n "${NVIDIA_RENDER_NODE}" ]; then
      export DRI_NODE="${NVIDIA_RENDER_NODE}"
      NVIDIA_DRI_NODE_OPT="${NVIDIA_RENDER_NODE}"
      echo "[svc-selkies] GPU_VENDOR=nvidia: pixelflux renders and encodes (NVENC) on ${NVIDIA_RENDER_NODE}"
    else
      echo "[svc-selkies] GPU_VENDOR=nvidia: no NVIDIA DRM render node in /dev/dri; pixelflux cannot select NVENC (load nvidia_drm on the host and pass --device /dev/dri)." >&2
    fi
  else
    # WSL2: the GPU is /dev/dxg plus CUDA; /dev/dri only holds the WSL virtual
    # node (driver "faux_driver"/vgem). pixelflux 2.0 decides on NVENC solely
    # from the render node's sysfs driver name, and the WSL libcuda lacks the
    # two CUDA/EGL interop symbols its loader resolves up front, so without
    # help it silently falls back to CPU x264. pixelflux-nvenc-wsl.so (source
    # in /usr/local/src) answers that one sysfs lookup with "nvidia" and stubs
    # the two symbols. Pointing the encoder at /dev/dxg, which pixelflux
    # cannot match to the render node, selects its readback path: Mesa D3D12
    # renders, the frame is read back and uploaded to CUDA, NVENC compresses.
    # Zero-copy EGL import is not available through Mesa D3D12.
    NVENC_WSL_SHIM=/usr/local/lib/pixelflux-nvenc-wsl.so
    if [ "${NVENC_READY}" = true ] && [ "${PIXELFLUX_WAYLAND:-false}" = "true" ]; then
      if [ ! -r "${NVENC_WSL_SHIM}" ]; then
        echo "[svc-selkies] Missing NVENC WSL shim: ${NVENC_WSL_SHIM}. Rebuild the base image." >&2
        exit 1
      fi
      export LD_PRELOAD="${NVENC_WSL_SHIM}${LD_PRELOAD:+:${LD_PRELOAD}}"
      # With an explicit encode path pixelflux resolves the encoder driver
      # from index 0, i.e. renderD128.
      export PIXELFLUX_NVENC_WSL_NODE=renderD128
      export PIXELFLUX_ENCODE_NODE_PATH=/dev/dxg
      echo "[svc-selkies] GPU_VENDOR=nvidia-wsl: pixelflux will use NVENC through CUDA on /dev/dxg (D3D12 render, readback, NVENC encode)"
    elif [ "${NVENC_READY}" = true ]; then
      echo "[svc-selkies] GPU_VENDOR=nvidia-wsl: X11 pixelflux; NVENC selection is left to pixelflux"
    fi
  fi
  if [ "${NVENC_READY}" = true ]; then
    export SELKIES_FORCE_HARDWARE_ENCODING=1
  fi
elif [ "${GPU_VENDOR}" = "intel-wsl" ] || [ "${GPU_VENDOR}" = "amd-wsl" ]; then
  # Intel/AMD on WSL2: the GPU itself is /dev/dxg and /dev/dri only holds the
  # vgem render node, so the i915/amdgpu sysfs lookup below cannot apply.
  # LIBVA_DRIVER_NAME=d3d12 (plus MESA_LOADER_DRIVER_OVERRIDE=d3d12, which
  # routes any DRM fd to the d3d12 gallium driver) makes libva load Mesa's
  # d3d12 VA-API driver, which encodes H.264 through the Windows driver's
  # D3D12 Video Encode API. Hand pixelflux the vgem node as its VA-API node;
  # pixelflux falls back to x264 on its own if the driver has no encoder.
  export LIBVA_DRIVER_NAME="${LIBVA_DRIVER_NAME:-d3d12}"
  # Mesa's d3d12 VA-API driver only initialises through the vgem path
  # (vl_vgem_drm_screen_create), which requires MESA_LOADER_DRIVER_OVERRIDE to
  # be unset and GALLIUM_DRIVER=d3d12. With the override set, libva reports
  # "resource allocation failed" on every Mesa version, which is why this
  # profile used to fall back to x264 unconditionally. GL via gbm reaches the
  # same d3d12 screen through the kms_swrast fallback, so pixelflux's own
  # renderer is unaffected by dropping the override.
  unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_ALWAYS_SOFTWARE
  # Mesa 23.2.1 crashes in Intel's EncodeFrame path under desktop activity.
  # 26.0.8 returns empty H.264 packets on this host; 25.2.8 produces actual
  # coded frames. Isolate the video driver, leaving desktop OpenGL unchanged.
  WSL_TRY_VAAPI=true
  WSL_VAAPI_DIR="${WSL_VAAPI_DIR:-/opt/wsl-vaapi}"
  if [ "${GPU_VENDOR}" = "intel-wsl" ] && [ -f "${WSL_VAAPI_DIR}/d3d12_drv_video.so" ]; then
    export LIBVA_DRIVERS_PATH="${WSL_VAAPI_DIR}"
    export LD_LIBRARY_PATH="${WSL_VAAPI_DIR}:${LD_LIBRARY_PATH}"
    export GALLIUM_DRIVER=d3d12
    export SELKIES_FORCE_HARDWARE_ENCODING=1
    # Intel's WSL D3D12 UMD is not safe when the Wayland OpenGL renderer and
    # VA-API encoder share one process.  Pixelflux keeps rendering on the GPU,
    # reads back NV12, and runs only FFmpeg/VA-API in a clean child process.
    export PIXELFLUX_VAAPI_EXTERNAL_PROCESS=1
    # Serialize VA completion waits against concurrent buffer submission.
    # Queue/VBV tuning alone did not fix the UMD crash; leave their defaults.
    unset D3D12_VIDEO_ENC_ASYNC_DEPTH D3D12_VIDEO_ENC_CBR_FORCE_VBV_EQUAL_BITRATE
    WSL_VAAPI_GATE=/usr/local/lib/wsl-vaapi-serialize.so
    if [ ! -r "${WSL_VAAPI_GATE}" ]; then
      echo "[svc-selkies] Missing Intel WSL VA-API synchronization shim: ${WSL_VAAPI_GATE}" >&2
      exit 1
    fi
    export LD_PRELOAD="${WSL_VAAPI_GATE}${LD_PRELOAD:+:${LD_PRELOAD}}"
    echo "[svc-selkies] GPU_VENDOR=intel-wsl: using isolated D3D12 VA-API driver from ${WSL_VAAPI_DIR}"
  elif [ "${GPU_VENDOR}" = "intel-wsl" ] && [ "${WSL_INTEL_VAAPI:-0}" != "1" ]; then
    echo "[svc-selkies] Intel GPU encoder driver missing from ${WSL_VAAPI_DIR}; refusing CPU fallback. Rebuild the base image." >&2
    exit 1
  elif [ "${GPU_VENDOR}" = "amd-wsl" ]; then
    export GALLIUM_DRIVER=d3d12
    # AMD: the system Mesa d3d12 VA-API driver on the Radeon adapter. The
    # same-process zero-copy VA path cannot import pixelflux's D3D12 GL
    # buffers on WSL (vaCreateSurfaces reports UNIMPLEMENTED, as seen on
    # Intel), and a same-process failure only falls back to CPU x264. Use
    # the vendor-neutral isolated FFmpeg readback encoder that intel-wsl
    # runs, without Intel's pinned Mesa build and VA synchronization shim,
    # and prove the Windows driver's D3D12 Video Encode first.
    unset LIBVA_DRIVERS_PATH
    # Test the node the encoder child will open (same preference as
    # WSL_VA_NODE below: Microsoft's documented card0 first).
    AMD_WSL_VA_NODE="${DRI_NODE:-/dev/dri/renderD128}"
    if [ -e /dev/dri/card0 ]; then AMD_WSL_VA_NODE=/dev/dri/card0; fi
    if wsl_d3d12_vaapi_preflight "${AMD_WSL_VA_NODE}"; then
      export PIXELFLUX_VAAPI_EXTERNAL_PROCESS=1
      export SELKIES_FORCE_HARDWARE_ENCODING=1
      echo "[svc-selkies] GPU_VENDOR=amd-wsl: D3D12 VA-API H.264 encode verified on adapter '${MESA_D3D12_DEFAULT_ADAPTER_NAME:-default}'; using the isolated FFmpeg encoder"
    else
      WSL_TRY_VAAPI=false
      echo "[svc-selkies] GPU_VENDOR=amd-wsl: no working D3D12 H.264 encode through Mesa VA-API; falling back to CPU x264. Update the Windows Radeon driver and WSL, then run ./check-wsl-gpu.sh" >&2
    fi
  else
    export GALLIUM_DRIVER=d3d12
  fi
  # Encoding and display rendering are independent. Even while x264 remains
  # selected, run pixelflux's Wayland renderer on D3D12 in every GPU display
  # mode. This removes the expensive llvmpipe framebuffer/readback path that
  # otherwise makes a high-resolution desktop visibly stutter.
  case "${WSL_GPU_MODE:-software}" in
    full|compositor|applications) export GALLIUM_DRIVER=d3d12 ;;
  esac
  VAAPI_INDEX=""
  # Microsoft documents card0 for accelerated video in WSL containers. Keep
  # the exact path for pixelflux 2 instead of forcing it through the legacy
  # renderD128-based integer API. Older pixelflux releases retain the index
  # fallback below.
  WSL_VA_NODE=""
  if [ -e "/dev/dri/card0" ]; then
    WSL_VA_NODE="/dev/dri/card0"
  elif [ -n "${DRI_NODE:-}" ]; then
    WSL_VA_NODE="${DRI_NODE}"
  else
    for renderD in /dev/dri/renderD*; do
      if [ -e "$renderD" ]; then
        WSL_VA_NODE="$renderD"
        break
      fi
    done
  fi
  RENDER_NUM=""
  if [ "${WSL_TRY_VAAPI}" = "true" ] && [ -n "${WSL_VA_NODE}" ]; then
    export PIXELFLUX_ENCODE_NODE_PATH="${WSL_VA_NODE}"
    RENDER_NUM=$(echo "${WSL_VA_NODE}" | grep -oP 'renderD\K[0-9]+')
  fi
  if [ "${WSL_TRY_VAAPI}" = "true" ] && [ -n "${WSL_VA_NODE}" ]; then
    # The index is only meaningful for a renderD node. -1 lets pixelflux 2
    # consume PIXELFLUX_ENCODE_NODE_PATH directly for card0.
    VAAPI_INDEX="-1"
    if [ -n "${RENDER_NUM}" ]; then
      VAAPI_INDEX=$((RENDER_NUM - 128))
    fi
    export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="${VAAPI_INDEX}"
    export SELKIES_FORCE_HARDWARE_ENCODING=1
    echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: pixelflux will use VA-API via Mesa d3d12 on ${WSL_VA_NODE} (legacy index ${VAAPI_INDEX}, adapter '${MESA_D3D12_DEFAULT_ADAPTER_NAME:-default}')"
  elif [ "${WSL_TRY_VAAPI}" = "true" ]; then
    export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
    echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: no /dev/dri render node (run 'sudo modprobe vgem' on the WSL2 host), falling back to software encoding"
  else
    export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
  fi
elif [ "${GPU_VENDOR}" = "intel" ] || [ "${GPU_VENDOR}" = "amd" ]; then
  # Intel/AMD: Use VA-API with render node
  # Need to find the correct render node for the specified GPU vendor
  VAAPI_INDEX=""
  
  # Find the correct render node by checking the driver
  for renderD in /dev/dri/renderD*; do
    if [ -e "$renderD" ]; then
      RENDER_NUM=$(echo "$renderD" | grep -oP 'renderD\K[0-9]+')
      DRIVER_LINK="/sys/class/drm/renderD${RENDER_NUM}/device/driver"
      if [ -L "$DRIVER_LINK" ]; then
        DRIVER_NAME=$(basename "$(readlink -f "$DRIVER_LINK")")
        # Intel GPUs bind to i915 or, from Lunar Lake / Battlemage on, to xe.
        if [ "${GPU_VENDOR}" = "intel" ] && { [ "$DRIVER_NAME" = "i915" ] || [ "$DRIVER_NAME" = "xe" ]; }; then
          VAAPI_INDEX=$((RENDER_NUM - 128))
          echo "[svc-selkies] Found Intel GPU at renderD${RENDER_NUM} (driver: ${DRIVER_NAME})"
          break
        elif [ "${GPU_VENDOR}" = "amd" ] && [ "$DRIVER_NAME" = "amdgpu" ]; then
          VAAPI_INDEX=$((RENDER_NUM - 128))
          echo "[svc-selkies] Found AMD GPU at renderD${RENDER_NUM} (driver: ${DRIVER_NAME})"
          break
        fi
      fi
    fi
  done
  
  if [ -n "${VAAPI_INDEX}" ] && [ "${VAAPI_INDEX}" -ge 0 ] 2>/dev/null; then
    export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="${VAAPI_INDEX}"
    export SELKIES_FORCE_HARDWARE_ENCODING=1
    echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: pixelflux will use VA-API hardware encoding (index ${VAAPI_INDEX})"
  elif [ -n "${DRI_NODE}" ]; then
    # Fallback to DRI_NODE if set
    RENDER_NUM=$(echo "${DRI_NODE}" | grep -oP 'renderD\K[0-9]+')
    if [ -n "${RENDER_NUM}" ]; then
      VAAPI_INDEX=$((RENDER_NUM - 128))
      export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="${VAAPI_INDEX}"
      export SELKIES_FORCE_HARDWARE_ENCODING=1
      echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: pixelflux will use VA-API on ${DRI_NODE} (index ${VAAPI_INDEX})"
    else
      export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
      echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: Could not determine render node, falling back to software encoding"
    fi
  else
    export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
    echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: No matching render node found, falling back to software encoding"
  fi
else
  # No GPU or unknown: software encoding
  export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
  echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: pixelflux will use software encoding"
fi

# Always use selkies with pixelflux (WebSocket mode)
SELKIES_CMD="selkies"
CMD_OPTS=(--addr="localhost" --mode="websockets" --port="${PORT}")
CMD_OPTS+=(--scaling-dpi="${DPI:-96}")

# Disable selkies's own basic auth - nginx (auth-server.py) handles authentication.
# Without this, selkies defaults to enable_basic_auth=True and requires credentials
# that nginx does not pass when proxying, causing WebSocket 401 failures.
CMD_OPTS+=(--enable-basic-auth=false)

# Clean up stale selkies socket files from previous run to prevent EADDRINUSE errors
rm -f /tmp/selkies_js*.sock /tmp/selkies_event*.sock 2>/dev/null || true

# Set web-root so selkies finds its static files without needing the selkies_web
# Python subpackage (which is absent in newer selkies installs / Python 3.14+).
# Prefer /usr/share/selkies/web (runtime copy with nginx patches applied by init-nginx),
# fall back to the original dashboard directory.
if [ -f "/usr/share/selkies/web/index.html" ]; then
  CMD_OPTS+=(--web-root="/usr/share/selkies/web")
elif [ -f "/usr/share/selkies/selkies-dashboard/index.html" ]; then
  CMD_OPTS+=(--web-root="/usr/share/selkies/selkies-dashboard")
fi

# Configure encoder based on GPU vendor
# NOTE: Selkies pixelflux only accepts: x264enc, x264enc-striped, jpeg
# Hardware encoding (NVENC/VA-API) is controlled via:
#   - --use-cpu=false (default): pixelflux auto-detects GPU and uses hardware encoding
#   - --use-cpu=true: force software encoding
#   - For VA-API, set PIXELFLUX_VAAPI_RENDER_NODE_INDEX env var (already done above)
ENCODER_TYPE="x264enc"

if [ "${GPU_VENDOR}" = "nvidia" ] || [ "${GPU_VENDOR}" = "nvidia-wsl" ]; then
  # NVIDIA: pixelflux selects NVENC when --use-cpu=false and the encoder node
  # resolves to the NVIDIA driver (see the GPU_VENDOR block above).
  CMD_OPTS+=(--encoder="${ENCODER_TYPE}")
  CMD_OPTS+=(--use-cpu=false)
  if [ -n "${NVIDIA_DRI_NODE_OPT}" ]; then
    CMD_OPTS+=(--dri-node="${NVIDIA_DRI_NODE_OPT}")
    echo "[svc-selkies] Added --dri-node=${NVIDIA_DRI_NODE_OPT} so pixelflux encodes on the NVIDIA GPU"
  fi
  if [ "${NVENC_READY:-false}" = true ]; then
    echo "[svc-selkies] Using NVIDIA NVENC hardware encoding"
  else
    echo "[svc-selkies] NVENC runtime missing; pixelflux will fall back to CPU x264" >&2
  fi
elif { [ "${GPU_VENDOR}" = "intel" ] || [ "${GPU_VENDOR}" = "amd" ] || [ "${GPU_VENDOR}" = "intel-wsl" ] || [ "${GPU_VENDOR}" = "amd-wsl" ]; } && [ "${WSL_TRY_VAAPI:-true}" = "true" ]; then
  # Intel/AMD (native or WSL2): pixelflux uses VA-API via PIXELFLUX_VAAPI_RENDER_NODE_INDEX env var
  CMD_OPTS+=(--encoder="${ENCODER_TYPE}")
  CMD_OPTS+=(--use-cpu=false)
  
  if [ -n "${VAAPI_INDEX}" ]; then
    DRI_NODE_PATH="/dev/dri/renderD$((128 + VAAPI_INDEX))"
    if [ -e "${DRI_NODE_PATH}" ]; then
      CMD_OPTS+=(--dri-node="${DRI_NODE_PATH}")
      echo "[svc-selkies] Added --dri-node=${DRI_NODE_PATH} for VA-API encoding"
    fi
  fi
  echo "[svc-selkies] Using VA-API hardware encoding (pixelflux via PIXELFLUX_VAAPI_RENDER_NODE_INDEX=${PIXELFLUX_VAAPI_RENDER_NODE_INDEX})"
else
  # Software encoder (x264enc) - force CPU encoding
  CMD_OPTS+=(--encoder="${ENCODER_TYPE}")
  CMD_OPTS+=(--use-cpu=true)
  echo "[svc-selkies] Using software encoding (CPU only)"
fi

# Enable H.264 streaming mode for lower latency (crucial for responsiveness!)
# This enables low-latency encoding with reduced buffering
CMD_OPTS+=(--h264-streaming-mode=true)
echo "[svc-selkies] H.264 streaming mode enabled for low latency"

# Framerate configuration
# SELKIES_FRAMERATE can be:
#   - A single value (e.g., "60") for fixed framerate
#   - A range (e.g., "30-60") to allow client-side selection within range
# Lower values improve stability and reduce latency
# Recommended: "30" for low latency, "30-60" for balanced performance
SELKIES_FRAMERATE="${SELKIES_FRAMERATE:-30}"
CMD_OPTS+=(--framerate="${SELKIES_FRAMERATE}")
echo "[svc-selkies] Framerate set to: ${SELKIES_FRAMERATE}"

# CRF (Constant Rate Factor) for H.264 encoding
# Lower = better quality but larger file size and more latency
# Higher = lower quality but faster encoding and less latency
# Range: 0-51, Recommended: 23-28 for low latency, 18-22 for quality
# Default: 25 for balanced latency/quality
SELKIES_H264_CRF="${SELKIES_H264_CRF:-25}"
CMD_OPTS+=(--h264-crf="${SELKIES_H264_CRF}")
echo "[svc-selkies] H.264 CRF set to: ${SELKIES_H264_CRF}"

if [[ "${PIXELFLUX_VAAPI_EXTERNAL_PROCESS:-0}" == "1" ]]; then
  # intel-wsl and amd-wsl: the isolated FFmpeg encoder is bitrate-controlled
  # only (h264_vaapi CBR/VBR, no CQP), and the pixelflux wheel caps it at
  # 8 Mbps. Stay in Pixelflux's bitrate-controlled hardware branch so CQP
  # paint-over changes never try to reopen the encoder. VBR is the default;
  # 8 Mbps CBR is used only when explicitly requested. The SELKIES_INTEL_*
  # names remain accepted for existing compose environments.
  export SELKIES_FORCE_HARDWARE_CBR=1
  export PIXELFLUX_VAAPI_RATE_CONTROL="${PIXELFLUX_VAAPI_RATE_CONTROL:-VBR}"
  SELKIES_WSL_VAAPI_TARGET_MBPS="${SELKIES_WSL_VAAPI_TARGET_MBPS:-${SELKIES_INTEL_VBR_TARGET_MBPS:-4}}"
  SELKIES_WSL_VAAPI_MAX_MBPS="${SELKIES_WSL_VAAPI_MAX_MBPS:-${SELKIES_INTEL_VBR_MAX_MBPS:-8}}"
  # Old compose environments may still carry the former 12 Mbps value. Never
  # exceed 8 Mbps, for either VBR maximum or CBR compatibility.
  (( SELKIES_WSL_VAAPI_MAX_MBPS > 8 )) && SELKIES_WSL_VAAPI_MAX_MBPS=8
  (( SELKIES_WSL_VAAPI_TARGET_MBPS > SELKIES_WSL_VAAPI_MAX_MBPS )) && \
    SELKIES_WSL_VAAPI_TARGET_MBPS="${SELKIES_WSL_VAAPI_MAX_MBPS}"
  export PIXELFLUX_VAAPI_TARGET_BITRATE_KBPS="$((SELKIES_WSL_VAAPI_TARGET_MBPS * 1000))"
  export PIXELFLUX_VAAPI_MAX_BITRATE_KBPS="$((SELKIES_WSL_VAAPI_MAX_MBPS * 1000))"
  SELKIES_WSL_VAAPI_CBR_MBPS="${SELKIES_WSL_VAAPI_CBR_MBPS:-${SELKIES_INTEL_CBR_MBPS:-8}}"
  (( SELKIES_WSL_VAAPI_CBR_MBPS > 8 )) && SELKIES_WSL_VAAPI_CBR_MBPS=8
  CMD_OPTS+=(--rate-control-mode=cbr)
  if [ "${PIXELFLUX_VAAPI_RATE_CONTROL^^}" = "VBR" ]; then
    CMD_OPTS+=(--video-bitrate="${SELKIES_WSL_VAAPI_TARGET_MBPS}")
    echo "[svc-selkies] ${GPU_VENDOR}: isolated VA-API encoder, VBR target ${SELKIES_WSL_VAAPI_TARGET_MBPS} Mbps, maximum ${SELKIES_WSL_VAAPI_MAX_MBPS} Mbps"
  else
    CMD_OPTS+=(--video-bitrate="${SELKIES_WSL_VAAPI_CBR_MBPS}")
    echo "[svc-selkies] ${GPU_VENDOR}: isolated VA-API encoder, CBR compatibility mode at ${SELKIES_WSL_VAAPI_CBR_MBPS} Mbps"
  fi
fi

# Paint-over CRF for static scenes (higher quality when not moving)
SELKIES_H264_PAINTOVER_CRF="${SELKIES_H264_PAINTOVER_CRF:-20}"
if [[ "${PIXELFLUX_VAAPI_EXTERNAL_PROCESS:-0}" == "1" ]]; then
  # Pixelflux applies CQP paint-over changes by closing and reopening the
  # encoder. Intel's Windows D3D12 video UMD can segfault on the wl-encode
  # thread when motion follows a static paint-over, and the isolated encoder
  # has no CQP at all. Keep one GPU encoder session/config on every WSL
  # VA-API profile.
  export SELKIES_DISABLE_HARDWARE_PAINTOVER=1
  SELKIES_H264_PAINTOVER_CRF="${SELKIES_H264_CRF}"
  CMD_OPTS+=(--use-paint-over-quality=false)
  CMD_OPTS+=(--h264-paintover-burst-frames=0)
  echo "[svc-selkies] ${GPU_VENDOR}: H.264 paint-over reconfiguration disabled for encoder stability"
fi
CMD_OPTS+=(--h264-paintover-crf="${SELKIES_H264_PAINTOVER_CRF}")
echo "[svc-selkies] H.264 Paint-over CRF set to: ${SELKIES_H264_PAINTOVER_CRF}"

# Audio capture reads from the monitor source of the virtual output sink.
# Keep this overridable for installations that provide a different source.
SELKIES_AUDIO_DEVICE="${SELKIES_AUDIO_DEVICE:-output.monitor}"
CMD_OPTS+=(--audio-enabled=true)
CMD_OPTS+=(--audio-device-name="${SELKIES_AUDIO_DEVICE}")
echo "[svc-selkies] Audio enabled, device: ${SELKIES_AUDIO_DEVICE}"

# Disable binary (image) clipboard: wl-paste --list-types blocks indefinitely on
# wayland-0 (KWin) when the clipboard is empty, causing the process to appear as
# a Wayland app in the KDE taskbar.  Text clipboard works via Klipper D-Bus.
CMD_OPTS+=(--enable-binary-clipboard=false)
echo "[svc-selkies] Binary clipboard disabled (text clipboard via Klipper D-Bus)"

echo "[svc-selkies] Using selkies with pixelflux (GPU_VENDOR=${GPU_VENDOR}, use-cpu=${USE_CPU:-false})"

# The shared resolver keeps Selkies on the same backend-specific endpoint as
# the audio daemon and desktop session.
PULSE_SOCKET_PATH="${WEBTOP_PULSE_SOCKET}"

pactl_cmd() {
  # Do not use with-contenv here: it may still contain values inherited before
  # init-adduser selected the runtime backend.
  s6-setuidgid "$TARGET_USER" env \
    PULSE_SERVER="unix:${PULSE_SOCKET_PATH}" \
    XDG_RUNTIME_DIR="/run/user/${TARGET_UID_SEL}" \
    PULSE_RUNTIME_PATH="${PULSE_RUNTIME_PATH:-}" \
    pactl "$@"
}

pulse_has_sink() {
  local sink_name="$1"
  pactl_cmd list short sinks 2>/dev/null | awk '{print $2}' | grep -qx "${sink_name}"
}

pulse_has_source() {
  local source_name="$1"
  pactl_cmd list short sources 2>/dev/null | awk '{print $2}' | grep -qx "${source_name}"
}

# Default sink setup (wait until pulseaudio is ready, then create virtual sinks)
if [ ! -f '/dev/shm/audio.lock' ] || ! pulse_has_sink output || ! pulse_has_sink input || ! pulse_has_source output.monitor; then
  rm -f /dev/shm/audio.lock
  # ensure pulseaudio is up
  for i in $(seq 1 120); do
    if pactl_cmd info >/dev/null 2>&1; then
      READY=1
      break
    fi
    sleep 0.5
  done
  if [ "${READY:-0}" -eq 1 ]; then
    if ! pulse_has_sink output; then
      pactl_cmd \
        load-module module-null-sink \
        sink_name="output" \
        sink_properties=device.description="output" >/dev/null
    fi
    if ! pulse_has_sink input; then
      pactl_cmd \
        load-module module-null-sink \
        sink_name="input" \
        sink_properties=device.description="input" >/dev/null
    fi
    pactl_cmd set-default-sink output >/dev/null 2>&1 || true
    pactl_cmd set-default-source output.monitor >/dev/null 2>&1 || true
    if pulse_has_sink output && pulse_has_sink input && pulse_has_source output.monitor; then
      touch /dev/shm/audio.lock
    else
      echo "[svc-selkies] pulseaudio recovered, but virtual sinks are incomplete; retrying service startup." >&2
      exit 1
    fi
  else
    echo "[svc-selkies] pulseaudio not ready; retrying service startup." >&2
    exit 1
  fi
fi

# Setup dev mode if defined
if [ ! -z ${DEV_MODE+x} ]; then
  # Dev deps
  apt-get update
  apt-get install -y \
    nodejs
  npm install -g nodemon
  rm -Rf $HOME/.npm
  # Frontend setup
  if [[ "${DEV_MODE}" == "core" ]]; then
    # Core just runs from directory
    cd $HOME/src/addons/selkies-web-core
    s6-setuidgid "$TARGET_USER" npm install
    s6-setuidgid "$TARGET_USER" npm run serve &
  else
    # Build core
    cd $HOME/src/addons/selkies-web-core
    s6-setuidgid "$TARGET_USER" npm install
    s6-setuidgid "$TARGET_USER" npm run build
    s6-setuidgid "$TARGET_USER" cp dist/selkies-core.js ../${DEV_MODE}/src/
    s6-setuidgid "$TARGET_USER" nodemon --watch selkies-core.js --exec "npm run build && cp dist/selkies-core.js ../${DEV_MODE}/src/" & 
    # Copy touch gamepad
    s6-setuidgid "$TARGET_USER" cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/
    s6-setuidgid "$TARGET_USER" nodemon --watch ../universal-touch-gamepad/universalTouchGamepad.js --exec "cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/" &  
    # Copy themes
    s6-setuidgid "$TARGET_USER" cp -a nginx ../${DEV_MODE}/
    # Run passed frontend
    cd $HOME/src/addons/${DEV_MODE}
    s6-setuidgid "$TARGET_USER" npm install
    s6-setuidgid "$TARGET_USER" npm run serve &
  fi
  # Run backend
  cd $HOME/src/src
  s6-setuidgid "$TARGET_USER" \
    nodemon -V --ext py --exec \
      "python3" -m selkies \
      --addr="localhost" \
      --mode="websockets" \
      --debug="true"
fi

# Start Selkies
echo "[svc-selkies] Starting ${SELKIES_CMD} on port ${PORT}"
exec s6-setuidgid "$TARGET_USER" "${SELKIES_CMD}" "${CMD_OPTS[@]}"
